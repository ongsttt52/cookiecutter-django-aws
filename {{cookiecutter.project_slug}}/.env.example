# Django Settings
DEBUG=1
SECRET_KEY=django-insecure-local-dev-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/{{cookiecutter.project_slug}}

{% if cookiecutter.use_celery == "yes" or cookiecutter.use_websocket == "yes" -%}
# Redis
REDIS_URL=redis://redis:6379/0
{% endif -%}

{% if cookiecutter.use_celery == "yes" -%}
# Celery
CELERY_BROKER_URL=redis://redis:6379/0
{% endif -%}

{% if cookiecutter.use_websocket == "yes" -%}
# Channels (WebSocket)
CHANNEL_LAYERS_HOST=redis://redis:6379/1
{% endif -%}

# AWS S3 (Required for all environments)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME={{ cookiecutter.project_slug | replace("_", "-") }}-media-bucket

# Django Superuser (자동 생성 - 선택사항)
# 설정 시 컨테이너 시작 시 자동으로 superuser 생성
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=your-secure-password
# DJANGO_SUPERUSER_USERNAME=admin

# CORS (Production - comma separated)
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
{% if cookiecutter.aws_deployment == "ec2-all-in-one" %}
# EC2 Docker Compose (production)
POSTGRES_DB={{cookiecutter.project_slug}}
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
ENVIRONMENT=demo
{% endif %}
{% if cookiecutter.use_frontend == "yes" %}
# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://backend:8000
{% endif %}
